// This is your Prisma schema file,
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role          UserRoleRecord[]
  studentProfile StudentProfile?
  advisor         Advisor?
  threads         ForumThread[]
  posts           ForumPost[]
  transcripts     Transcript[]
  personalityQuiz PersonalityQuiz?
  studentConsultations  Consultation[] @relation("StudentConsultations")
  consultationMessages  ConsultationMessage[]
  postLikes           PostLike[]

  @@map("users")
}

enum UserRole {
  STUDENT
  ADVISOR
  ADMIN
}

model UserRoleRecord {
  userId      String   @map("user_id")
  role        UserRole
  universityId String? @map("university_id")
  isVerified  Boolean  @default(false) @map("is_verified")
  bio         String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University?  @relation(fields: [universityId], references: [id])

  @@id([userId, role])
  @@map("user_roles")
}

// ─────────────────────────────────────────────
// STUDENT PROFILE
// ─────────────────────────────────────────────

model StudentProfile {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  graduationYear  Int     @map("graduation_year")
  province        String?
  isProfilePublic Boolean @default(false) @map("is_profile_public")
  showGrades      Boolean @default(false) @map("show_grades")
  allowContact    Boolean @default(true) @map("allow_contact")
  showInForum     Boolean @default(true) @map("show_in_forum")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// ─────────────────────────────────────────────
// UNIVERSITIES & MAJORS
// ─────────────────────────────────────────────

model University {
  id           String   @id @default(cuid())
  code         String   @unique // KHA, HUST, FTU...
  name         String
  region       UniversityRegion @default(NORTH)
  type         UniversityType   @default(PUBLIC)
  address      String?
  websiteUrl   String?  @map("website_url")
  tuitionRange String?  @map("tuition_range")
  hotnessScore Int      @default(0) @map("hotness_score")
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")

  majors   Major[]
  advisors Advisor[]
  userRoles UserRoleRecord[]

  @@map("universities")
}

enum UniversityRegion {
  NORTH
  CENTRAL
  SOUTH
}

enum UniversityType {
  PUBLIC
  PRIVATE
  NATIONAL
  INTERNATIONAL
}

model Major {
  id           String  @id @default(cuid())
  universityId String  @map("university_id")
  code         String  // 7480101, 7340101...
  name         String
  subjectGroup String  @map("subject_group") // A00, D01...
  description  String?
  tuitionMin  Decimal? @map("tuition_min") // triệu VNĐ
  tuitionMax  Decimal? @map("tuition_max")
  careerPaths String[] @map("career_paths")
  isActive    Boolean  @default(true) @map("is_active")

  university       University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  admissionScores  AdmissionScore[]
  majorCategory    MajorCategory?      @relation(fields: [categoryId], references: [id])
  categoryId       String?

  @@unique([universityId, code])
  @@map("majors")
}

model MajorCategory {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  majors Major[]

  @@map("major_categories")
}

model AdmissionScore {
  id       String @id @default(cuid())
  majorId  String @map("major_id")
  year     Int
  method   String @default("Điểm thi THPT")
  score Decimal @db.Decimal(10,2)
  note     String?
  url      String?

  major Major @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@unique([majorId, year, method])
  @@map("admission_scores")
}

// ─────────────────────────────────────────────
// TRANSCRIPTS & PERSONALITY QUIZ
// ─────────────────────────────────────────────

model Transcript {
  id         String   @id @default(cuid())
  studentId  String   @map("student_id")
  semester   TranscriptSemester
  year       Int
  scores     Json     // {"math": 8.5, "literature": 8.0, ...}
  avgScore   Decimal? @map("avg_score")
  isDraft    Boolean  @default(false) @map("is_draft")
  imageUrl   String?  @map("image_url")
  ocrText    String?  @map("ocr_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semester, year])
  @@map("transcripts")
}

enum TranscriptSemester {
  HK1_L12
  HK2_L12
  GRADUATION_EXAM
}

model PersonalityQuiz {
  id              String   @id @default(cuid())
  studentId       String   @unique @map("student_id")
  answers         Json     // {q1: 2, q2: 0, ...}
  topCategories   String[] @map("top_categories") // ["tech", "business"]
  recommendations Json     // Full suggestion object
  createdAt       DateTime @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("personality_quizzes")
}

// ─────────────────────────────────────────────
// FORUM
// ─────────────────────────────────────────────

model ForumCategory {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  displayOrder  Int     @default(0) @map("display_order")

  threads ForumThread[]

  @@map("forum_categories")
}

model ForumThread {
  id                 String   @id @default(cuid())
  authorId           String   @map("author_id")
  categoryId         String   @map("category_id")
  title              String
  content            String
  viewsCount         Int      @default(0) @map("views_count")
  isPinned           Boolean  @default(false) @map("is_pinned")
  isLocked           Boolean  @default(false) @map("is_locked")
  officialReplyId    String?  @unique @map("official_reply_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  author           User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category        ForumCategory  @relation(fields: [categoryId], references: [id])
  posts            ForumPost[]
  officialReply    ForumPost?     @relation("OfficialReply", fields: [officialReplyId], references: [id])

  @@map("forum_threads")
}

model ForumPost {
  id               String   @id @default(cuid())
  threadId         String   @map("thread_id")
  authorId         String   @map("author_id")
  parentId         String?  @map("parent_id") // null = top-level reply
  content          String
  likesCount        Int      @default(0) @map("likes_count")
  isOfficialReply  Boolean  @default(false) @map("is_official_reply")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")

  thread    ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   ForumPost?    @relation("PostReplies", fields: [parentId], references: [id])
  replies  ForumPost[]   @relation("PostReplies")
  likedBy  PostLike[]
  officialReplyThread ForumThread? @relation("OfficialReply")

  @@map("forum_posts")
}

model PostLike {
  postId   String @map("post_id")
  userId   String @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_likes")
}

// ─────────────────────────────────────────────
// CONSULTATIONS
// ─────────────────────────────────────────────

model Advisor {
  id           String  @id @default(cuid())
  userId       String  @unique @map("user_id")
  universityId String  @map("university_id")
  title        String
  bio          String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id])

  consultations Consultation[]

  @@map("advisors")
}

model Consultation {
  id        String             @id @default(cuid())
  studentId String             @map("student_id")
  advisorId String?            @map("advisor_id")
  topic     String
  message   String
  status    ConsultationStatus @default(PENDING)
  createdAt DateTime           @default(now()) @map("created_at")

  student     User                  @relation("StudentConsultations", fields: [studentId], references: [id], onDelete: Cascade)
  advisor     Advisor?               @relation(fields: [advisorId], references: [id])
  messages ConsultationMessage[]

  @@map("consultations")
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
}

model ConsultationMessage {
  id              String   @id @default(cuid())
  consultationId  String   @map("consultation_id")
  senderId        String   @map("sender_id")
  content         String
  isOfficial      Boolean  @default(false) @map("is_official")
  createdAt       DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("consultation_messages")
}

// ─────────────────────────────────────────────
// ADMIN / SETTINGS
// ─────────────────────────────────────────────

model SystemSetting {
  key   String @id
  value Json

  @@map("system_settings")
}

model AcademicYear {
  id        String   @id @default(cuid())
  year      Int      @unique // 2025-2026
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("academic_years")
}